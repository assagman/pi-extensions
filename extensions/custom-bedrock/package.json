{
  "name": "custom-bedrock",
  "version": "1.0.0",
  "description": "Pi extension for routing requests through configurable custom Bedrock-compatible AI gateways",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "deploy": "./install.sh",
    "undeploy": "./uninstall.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.983.0",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
