{
  "name": "custom-bedrock",
  "version": "1.0.0",
  "description": "Pi extension for routing requests through a custom Bedrock-compatible AI gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "deploy": "./install.sh",
    "undeploy": "./uninstall.sh"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.983.0",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
